# ============================================================
#  secrets-rot — Environment Variables
#  Copy this file to .env and fill in your real values.
#  Never commit the filled .env to version control.
# ============================================================

KEY_PREFIX=neo-backend

# ─── Doppler ────────────────────────────────────────────────
DOPPLER_TOKEN=dp.st.dev.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DOPPLER_PROJECT=secret-rotator
DOPPLER_CONFIG=dev

# ─── 1. AWS ElastiCache (Redis) ─────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
ELASTICACHE_USER_GROUP_ID=dev
REDIS_AWS_URL=rediss://master.your-cluster.xxxxxx.aps1.cache.amazonaws.com:6379
REDIS_AWS_USERNAME=dev
REDIS_AWS_PASSWORD=your-redis-password

# ─── 2. GCP Kafka ───────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_KAFKA_CLUSTER_ID=your-kafka-cluster-id
GCP_KAFKA_LOCATION=us-central1
GCP_SA_EMAIL=kafka-sa@your-gcp-project-id.iam.gserviceaccount.com
# Provide EITHER a path to the JSON key file OR inline JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
GCP_SA_KEY_JSON={"type":"service_account","project_id":"your-project","private_key_id":"xxxx","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"kafka-sa@your-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ─── 3. Firebase ────────────────────────────────────────────
# TODO: Rotation strategy needs research
FIRE_CREDS_JSON=

# ─── 4. Cloudflare ──────────────────────────────────────────
# Master token — permanent, never rotated.
# Needs: User > API Tokens > Read + Edit
CLOUDFLARE_MASTER_TOKEN=your-cloudflare-master-token

# App token — rotated on every run. Set after first bootstrap run.
# Leave unset on first run (bootstrap mode).
CLOUDFLARE_API_TOKEN=your-cloudflare-app-token

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Required only for bootstrap (first run, no existing app token).
# Get permission group IDs from:
#   curl -s "https://api.cloudflare.com/client/v4/user/tokens/permission_groups" \
#     -H "Authorization: Bearer <CLOUDFLARE_MASTER_TOKEN>" \
#     | python3 -c "import json,sys; [print(p['id'],'-',p['name']) for p in json.load(sys.stdin)['result']]"
CLOUDFLARE_TOKEN_POLICY_JSON=[{"effect":"allow","resources":{"com.cloudflare.api.account.zone.*":"*"},"permission_groups":[{"id":"c8fed203ed3043cba015a93ad1616f1f"}]}]

# ─── 5. MongoDB Atlas ───────────────────────────────────────
MONGODB_ATLAS_PUBLIC_KEY=your-atlas-public-key
MONGODB_ATLAS_PRIVATE_KEY=your-atlas-private-key
MONGODB_ATLAS_GROUP_ID=your-atlas-project-id
MONGODB_ATLAS_USERNAME=your-db-username
MONGODB_URI=mongodb+srv://your-user:your-password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ─── 6. Apple APNS ──────────────────────────────────────────
# Note: APNS key rotation cannot be done programmatically.
# Rotate manually in Apple Developer portal, then update these values.
APNS_TEAM_ID=ABCDE12345
APNS_KEY_ID=FGHIJ67890
APNS_BUNDLE_ID=com.example.myapp
# Paste the full -----BEGIN PRIVATE KEY----- block (use \n for newlines):
APNS_AUTH_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----

# ─── 7. Deepgram ────────────────────────────────────────────
DEEPGRAM_MASTER_KEY=your-deepgram-master-api-key
DEEPGRAM_PROJECT_ID=your-deepgram-project-id
DEEPGRAM_API_KEY_ID=your-deepgram-api-key-id

# ─── 8. Anthropic ───────────────────────────────────────────
# Note: Anthropic does not support programmatic key rotation.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
ANTHROPIC_API_KEY_ID=apikey_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── 9. OpenAI ──────────────────────────────────────────────
# Note: OpenAI does not support programmatic key rotation.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 10. Gemini ─────────────────────────────────────────────
# Note: Gemini does not support programmatic key rotation.
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── 11. Elasticsearch ──────────────────────────────────────
ELASTICSEARCH_HOST=https://your-cluster-id.region.aws.elastic-cloud.com:443
# base64("key-id:api-key-secret") — the 'encoded' field from POST /_security/api_key
ELASTICSEARCH_API_KEY=your-base64-encoded-api-key
ELASTICSEARCH_API_KEY_ID=your-api-key-id
ELASTICSEARCH_MASTER_KEY=your-base64-encoded-master-key
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
# Optional: custom name for newly created keys (default: secrets-rot-rotated)
# ELASTICSEARCH_KEY_NAME=my-rotation-key
